# Environment variables Sanctum reads.
#
# Sanctum does not load a .env file: export these in your shell (or pass them
# to the process) to override the defaults shown. Names follow the settings
# in sanctum/config/settings.py: prefix SANCTUM_, sections joined with __.

# NLP
SANCTUM_NLP__SPACY_MODEL=en_core_web_sm
# Where the bundled GLiNER-PII model lives (default: next to the desktop
# sidecar, else ~/.cache/sanctum/models/). Fetch it with
# scripts/fetch_ner_model.py.
# SANCTUM_NLP__NER_MODEL_DIR=/path/to/gliner-pii-base-v1.0
SANCTUM_NLP__NER_THRESHOLD=0.2

# Analyzer
SANCTUM_ANALYZER__DEFAULT_SCORE_THRESHOLD=0.35
SANCTUM_ANALYZER__DEFAULT_LANGUAGE=en

# Anonymizer (see sanctum/anonymizer/operators/__init__.py for the operators)
SANCTUM_ANONYMIZER__DEFAULT_OPERATOR=hips

# Mapping store for reversible pseudonymization
SANCTUM_SECURITY__SESSION_ONLY=true
# SANCTUM_SECURITY__STORE_PATH=/path/to/mappings.store
